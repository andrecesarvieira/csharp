@page
@model SharpPontoWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Registros de Ponto";
}

<div class="mb-1"></div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<div class="mb-3"></div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Data</th>
            <th>Entrada</th>
            <th>Almoço</th>
            <th>Retorno</th>
            <th>Saída</th>
            <th>Manhã</th>
            <th>Tarde</th>
            <th>Total de Horas</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var registro in Model.Registros)
        {
            <tr>
                <td>@registro.Data.ToString("dd/MM/yyyy")</td>
                <td>@registro.Entrada</td>
                <td>@registro.Almoco</td>
                <td>@registro.Retorno</td>
                <td>@registro.Saida</td>
                <td>@registro.Manha</td>
                <td>@registro.Tarde</td>
                <td>@registro.TotalDia</td>
                <td>
                    <a asp-page="Editar" asp-route-id="@registro.Id" class="btn btn-warning btn-sm">Editar</a>
                    <form method="post" asp-page-handler="Excluir" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este registro?');">
                        <input type="hidden" name="id" value="@registro.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                    </form>
                </td>
            </tr>
        }

    </tbody>
</table>


<div class="d-flex justify-content-between align-items-center mb-3">
    <nav>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.PaginaAtual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
            </li>
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(Model.PaginaAtual == i ? "active" : "")">
                    <a class="page-link" asp-route-pagina="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
            </li>
        </ul>
    </nav>
    <form method="post" asp-page-handler="Registrar" class="ms-auto">
        <button type="submit" class="btn btn-primary">Registrar</button>
    </form>
</div>

<br></br>

<h5>Inserir Manualmente</h5>
<form method="post" asp-page-handler="Inserir" class="row g-3">
    <div class="col">
        <input type="date" name="Data" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col">
        <input type="time" name="Entrada" class="form-control" required />
    </div>
    <div class="col">
        <input type="time" name="Almoco" class="form-control" required />
    </div>
    <div class="col">
        <input type="time" name="Retorno" class="form-control" required />
    </div>
    <div class="col">
        <input type="time" name="Saida" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success col">Inserir</button>
</form>